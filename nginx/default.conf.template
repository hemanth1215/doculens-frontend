# DocuLens web server. Rendered at container start by the nginx image's envsubst step:
# only ${DOCULENS_*} and ${NGINX_RESOLVER} are substituted (NGINX_ENVSUBST_FILTER), nginx's own $variables stay intact.
server {
    listen 8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;

    # Uploads: 100 MB PDF + multipart overhead (matches spring.servlet.multipart.max-request-size).
    client_max_body_size 101m;

    # Re-resolve the backend name so a restarted backend container (new IP) is found again.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $doculens_backend ${DOCULENS_BACKEND_ORIGIN};

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        proxy_pass $doculens_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # nginx is the edge here: replace any client-supplied X-Forwarded-For so the backend sees the real peer
        # address (it is used for per-IP rate limits). Behind another proxy, use $proxy_add_x_forwarded_for instead.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        # SSE: pass tokens through immediately. Uploads: stream the body instead of buffering 100 MB in the proxy.
        proxy_buffering off;
        proxy_request_buffering off;
        # The backend sends an SSE heartbeat every 15 s and caps an answer at 60 s; uploads of large files take a while.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Hashed build output never changes: cache for a year.
    location ~* \.(?:js|css|woff2?)$ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # SPA routes fall back to index.html, which is never cached so new deployments are picked up.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
